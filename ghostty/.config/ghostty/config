shell-integration = none

theme = Monokai Remastered
# background = #0D1118
background = #000000

mouse-hide-while-typing = true

window-decoration = auto
macos-titlebar-style = transparent

# font-family = ComicShannsMono Nerd Font
font-family = GeistMono Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
# font-family = Monaspace Argon
# font-feature = calt,liga,dlig,ss01,ss02,ss03,ss04,ss05,ss06,ss07,ss08
# font-family-italic = Monaspace Radon
font-size = 15
adjust-cell-height = 0%
# adjust-cell-width = 0%
# 0 to 255
font-thicken-strength = 30
font-thicken = false

window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

background-opacity = 1
background-blur = 10

confirm-close-surface = false

copy-on-select = clipboard

# custom-shader = cursor_warp.glsl

### HERDR BINDS

# switch tabs (aka windows)
keybind = super+1=text:\x021
keybind = super+2=text:\x022
keybind = super+3=text:\x023
keybind = super+4=text:\x024
keybind = super+5=text:\x025
keybind = super+6=text:\x026
keybind = super+7=text:\x027
keybind = super+8=text:\x028
keybind = super+9=text:\x029
# new ghostty version or something needs this
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+digit_9=text:\x029

# switch panes
keybind = super+h=text:\x02h
keybind = super+j=text:\x02j
keybind = super+k=text:\x02k
keybind = super+l=text:\x02l

# split panes
keybind = super+shift+h=text:\x02v
keybind = super+shift+j=text:\x02-
keybind = super+shift+k=text:\x02-
keybind = super+shift+l=text:\x02v
keybind = super+x=text:\x02x

# create tab
keybind = super+t=text:\x02c

# close tab
keybind = super+w=text:\x02x

# open sessions
keybind = super+s=text:\x02s

# open sessionizer
keybind = super+f=text:\x02g

# go to last session
keybind = super+b=text:\x02b

# select mode
keybind = super+[=text:\x02[
keybind = super+u=text:\x02U
keybind = super+d=text:\x02D
keybind = super+/=text:\x02/
